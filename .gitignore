# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Framework and build output
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/

# Keep the project-owned Vite plugin while ignoring other build artifacts
/build/*
!/build/sites-vite-plugin.ts

# Tests and tooling caches
/coverage/
/.nyc_output/
.eslintcache
*.tsbuildinfo
next-env.d.ts

# Local environment files
.env
.env.*
!.env.example
!.env.*.example
.dev.vars*
!.dev.vars.example

# Deployment metadata
/.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors and operating systems
.DS_Store
Thumbs.db
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.swp
*~

# Local certificates
*.pem
